# Database (SQLite for local dev — file is created by `npx prisma migrate dev`)
DATABASE_URL="file:./prisma/dev.db"

# GitHub OAuth (NextAuth "Sign in with GitHub")
# Callback URL in GitHub OAuth App settings MUST be:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth — generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Queue
REDIS_URL=redis://localhost:6379
